diff --git a/node_modules/ratex-react-native/RaTeXRuntime.podspec b/node_modules/ratex-react-native/RaTeXRuntime.podspec
new file mode 100644
index 0000000..20f41ce
--- /dev/null
+++ b/node_modules/ratex-react-native/RaTeXRuntime.podspec
@@ -0,0 +1,14 @@
+Pod::Spec.new do |s|
+  s.name = 'RaTeXRuntime'
+  s.version = '0.1.4'
+  s.summary = 'Dynamic wrapper for the RaTeX Rust runtime'
+  s.homepage = 'https://github.com/erweixin/RaTeX'
+  s.license = 'MIT'
+  s.author = 'Mattermost'
+  s.source = { :git => 'https://github.com/erweixin/RaTeX.git', :tag => s.version.to_s }
+  s.platform = :ios, '18.0'
+  s.source_files = 'RaTeXRuntime.c'
+  s.vendored_frameworks = 'ios/RaTeX.xcframework'
+  # Retain the Rust FFI exports consumed by the separate React Native bridge.
+  s.pod_target_xcconfig = { 'OTHER_LDFLAGS' => '$(inherited) -all_load' }
+end
